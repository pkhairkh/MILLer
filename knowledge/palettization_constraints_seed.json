      "payload": {
        "constraint_type": "conv_palette_minimums",
        "conv_standard_min_bits": 4,
        "conv_alternate_min_bits": 3,
        "conv_never_bits": 1,
        "notes": "Standard conv palettization requires at least 4-bit LUT. Alternate path supports 3-bit minimum. 1-bit and 2-bit palettization are not supported by ANE hardware."
