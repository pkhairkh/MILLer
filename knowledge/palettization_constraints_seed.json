          "unknown"
        ]
      },
      "conflict_priority": 0,
      "payload": {
        "constraint_type": "palette_upcast",
        "from_3bit_to_4bit": true,
        "affected_families": [
          "A11Legacy",
          "A12",
          "A13"
        ],
        "notes": "On A11-A13, 3-bit palettized weights are silently upcast to 4-bit by the ANECompiler, increasing model size. This does not happen on A14+."
      }
    },
